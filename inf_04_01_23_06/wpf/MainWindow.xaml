<Window x:Class="wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="auto" Width="auto">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Height="30">
            <Label Content="Złotówki: "/>
            <TextBox x:Name="txtZlotowki" Width="200" Height="30"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Height="30">
            <GroupBox x:Name="waluty">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/apple.jpg" Width="20" Height="20" Margin="5"/>
                        <RadioButton x:Name="rbEuro" Content="Euro" Margin="5" IsChecked="True"/>
                    </StackPanel>
                    <RadioButton x:Name="rbDolar" Content="Dolar" Margin="5"/>
                    <RadioButton x:Name="rbFunt" Content="Funt" Margin="5"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="btnPrzelicz" Content="Przelicz" Width="100" Height="30" Click="btnPrzelicz_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label Content="Wynik: "/>
            <TextBox x:Name="txtWynik" Width="200" Height="30" IsReadOnly="True"/>
        </StackPanel>
    </StackPanel>
</Window>
