<Window x:Class="Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop"
        mc:Ignorable="d"
        Title="Nadaj Przesyłkę, PESEL: 00000000000" Height="450" Width="600">
    <StackPanel Orientation="Vertical" Margin="15">
        <StackPanel Orientation="Horizontal">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="10, 0, 0, 0">
                    <GroupBox Header="Rodzaj przesyłki" Margin="0, 20, 20, 5" Width="180">
                        <StackPanel Orientation="Vertical">
                            <RadioButton x:Name="RadioPoczt" Content="Pocztówka" GroupName="PackageType" Margin="5" IsChecked="True"/>
                            <RadioButton x:Name="RadioList" Content="List" GroupName="PackageType" Margin="5"/>
                            <RadioButton x:Name="RadioPaczk" Content="Paczka" GroupName="PackageType" Margin="5"/>
                        </StackPanel>
                    </GroupBox>
                    <Button Content="Sprawdź cenę:" Width="180" Margin="-20, 0, 0, 0" Click="Button_Click_Check"></Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="-20, 10, 10, 10">
                    <Image x:Name="Img" Source="src/pocztowka.png" Width="140" Height="90" Margin="30, 0, 0, 0"/>
                    <TextBlock x:Name="Price" Text="Cena:    " Margin="10, 10, 0, 0" FontWeight="Bold" FontSize="16" Width="100"/>
                </StackPanel>
            </StackPanel>
            <GroupBox Header="Dane adresowe" Margin="20, 20, 20, 5" Width="250" Height="200" VerticalAlignment="Top">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Ulica z numerem" Margin="5"/>
                    <TextBox x:Name="Street" Margin="5"/>
                    <TextBlock Text="Kod pocztowy" Margin="5"/>
                    <TextBox x:Name="Zip" Margin="5" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Text="Miasto" Margin="5"/>
                    <TextBox x:Name="City" Margin="5"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <Button Content="Zatwierdź" HorizontalAlignment="Center" Width="550" Click="Button_Click_Confirm"></Button>
    </StackPanel>
</Window>
