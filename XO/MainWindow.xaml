<Window x:Class="XO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XO"
        mc:Ignorable="d"
        Title="X O" Height="650" Width="900"
        Background="DarkGray">

    <StackPanel Orientation="Horizontal" Margin="25">
        <StackPanel Orientation="Vertical" Width="550" Margin="0,0,25,0">
            <TextBlock Text="X oraz O"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="DimGray"
                       Margin="5,15,0,25"/>

            <StackPanel Background="DimGray" Margin="0,0,0,15">
                <TextBlock x:Name="PlayerText"
                           Text="Gracz X"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="WhiteSmoke"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btn1" Click="Button_Click" Width="155" Height="115" Margin="3" FontSize="42" FontWeight="Bold" Background="WhiteSmoke" Foreground="DarkSlateGray" BorderThickness="0"/>
                    <Button x:Name="btn2" Click="Button_Click" Width="155" Height="115" Margin="3" FontSize="42" FontWeight="Bold" Background="WhiteSmoke" Foreground="DarkSlateGray" BorderThickness="0"/>
                    <Button x:Name="btn3" Click="Button_Click" Width="155" Height="115" Margin="3" FontSize="42" FontWeight="Bold" Background="WhiteSmoke" Foreground="DarkSlateGray" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btn4" Click="Button_Click" Width="155" Height="115" Margin="3" FontSize="42" FontWeight="Bold" Background="WhiteSmoke" Foreground="DarkSlateGray" BorderThickness="0"/>
                    <Button x:Name="btn5" Click="Button_Click" Width="155" Height="115" Margin="3" FontSize="42" FontWeight="Bold" Background="WhiteSmoke" Foreground="DarkSlateGray" BorderThickness="0"/>
                    <Button x:Name="btn6" Click="Button_Click" Width="155" Height="115" Margin="3" FontSize="42" FontWeight="Bold" Background="WhiteSmoke" Foreground="DarkSlateGray" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btn7" Click="Button_Click" Width="155" Height="115" Margin="3" FontSize="42" FontWeight="Bold" Background="WhiteSmoke" Foreground="DarkSlateGray" BorderThickness="0"/>
                    <Button x:Name="btn8" Click="Button_Click" Width="155" Height="115" Margin="3" FontSize="42" FontWeight="Bold" Background="WhiteSmoke" Foreground="DarkSlateGray" BorderThickness="0"/>
                    <Button x:Name="btn9" Click="Button_Click" Width="155" Height="115" Margin="3" FontSize="42" FontWeight="Bold" Background="WhiteSmoke" Foreground="DarkSlateGray" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="ResultText"
                       Text=""
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="DimGray"
                       HorizontalAlignment="Center"
                       Margin="0,18,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" Width="245" Background="DimGray" Margin="0,5,0,5">

            <TextBlock Text="Runda"
                       FontSize="15"
                       Foreground="WhiteSmoke"
                       Margin="20,30,0,5"/>

            <TextBlock x:Name="RoundText"
                       Text="1"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="WhiteSmoke"
                       Margin="20,0,0,30"/>

            <TextBlock Text="Wyniki"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="WhiteSmoke"
                       Margin="20,5,0,20"/>

            <StackPanel Orientation="Horizontal" Margin="20,5">
                <TextBlock Text="Gracz X"
                           FontSize="15"
                           Foreground="WhiteSmoke"
                           Width="130"/>
                <TextBlock x:Name="ScoreX"
                           Text="0"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="WhiteSmoke"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="20,5">
                <TextBlock Text="Gracz O"
                           FontSize="15"
                           Foreground="WhiteSmoke"
                           Width="130"/>
                <TextBlock x:Name="ScoreO"
                           Text="0"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="WhiteSmoke"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="20,5">
                <TextBlock Text="Remisy"
                           FontSize="15"
                           Foreground="WhiteSmoke"
                           Width="130"/>
                <TextBlock x:Name="Draws"
                           Text="0"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="WhiteSmoke"/>
            </StackPanel>

            <Button x:Name="btnNewGame"
                    Content="Nowa runda"
                    Click="btnNewGame_Click"
                    Width="195"
                    Height="45"
                    Background="Gainsboro"
                    Foreground="Black"
                    FontWeight="Bold"
                    FontSize="14"
                    BorderThickness="0"
                    HorizontalAlignment="Center"
                    Margin="0,45,0,10"/>
        </StackPanel>
    </StackPanel>
</Window>
